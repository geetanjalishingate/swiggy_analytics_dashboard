      <aliases enabled='yes' />
      <column datatype='string' name='[Actual Delivery Time]' role='dimension' type='nominal' />
      <column caption='Total Orders' datatype='integer' name='[Calculation_1145205162811392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([OrderID])' />
      </column>
      <column caption='Total Revenue' datatype='integer' name='[Calculation_1145205163278338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total Amount])' />
      </column>
      <column caption='AOV' datatype='integer' name='[Calculation_1145205163589635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DIV([Calculation_1145205163278338], [Calculation_1145205162811392])' />
      </column>
      <column caption='Is Repeat' datatype='string' name='[Calculation_1145205166137350]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Order Count Per Customer] &gt; 1 THEN &quot;Repeat&quot; ELSE &quot;One-Time&quot; END' />
      </column>
      <column caption='Is Repeat %' datatype='real' name='[Calculation_1145205166968840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_1145205166137350] = &quot;Repeat&quot; THEN [Customer ID] END)&#13;&#10;/ COUNTD([Customer ID])' />
      </column>
      <column caption=' Purchase Frequency' datatype='real' name='[Calculation_1145205169512459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([OrderID]) / COUNTD([Customer ID])' />
      </column>
      <column caption='CLV' datatype='real' name='[Calculation_1145205169700876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1145205163589635] *[Calculation_1145205169512459]' />
      </column>
      <column caption='Total Customers' datatype='integer' name='[Calculation_1145205170708493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer ID (orders)])' />
      </column>
      <column caption='Delivery Efficency' datatype='real' name='[Calculation_1145205172273166]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Delivery Status] = &quot;Delivered&quot; THEN [Delivery ID] END)&#13;&#10;/ COUNTD([Delivery ID])' />
      </column>
      <column caption='Order Cancelled rate' datatype='real' name='[Calculation_1145205172719631]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Status] = &quot;Cancelled&quot; THEN [OrderID] END)&#13;&#10;/ COUNTD([OrderID])' />
      </column>
      <column caption='Customers satisfaction scor' datatype='real' name='[Calculation_1145205173133328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Delivery Feedback Rating])' />
      </column>
      <column caption='Active Delivery Agent' datatype='integer' name='[Calculation_1145205173813265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Delivery Agent ID])' />
      </column>
      <column caption='Average Delivery Time' datatype='real' name='[Calculation_1145205174120466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Delivery Time (mins)])' />
      </column>
      <column caption='Revenue Per Customer' datatype='real' name='[Calculation_1145205174366227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Final Amount Paid]) / COUNTD([Customer ID])' />
      </column>
      <column caption='No. Of Items' datatype='integer' name='[Calculation_1145205176188949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([MenuItem ID])' />
      </column>
      <column caption='Avg Rating' datatype='real' name='[Calculation_1145205176541206]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Rating])' />
      </column>
      <column caption='Customer Order Count' datatype='integer' name='[Calculation_1145205177495576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Customer ID] : COUNT([OrderID]) }' />
      </column>
      <column caption='Repeat Customer Flag' datatype='integer' name='[Calculation_1145205177708569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1145205177495576] &gt; 1 THEN 1 ELSE 0 END' />
      </column>
